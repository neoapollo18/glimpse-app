{
  "$comment": "Locks & Mane brand config for compile-brand-flow.cjs. Everything brand-specific lives HERE; the compiler and the runtime engine are generic. Encodes the 2026-07 spec: Rule Set 1 (accessory branch by style intent), Rule Set 2 (2-sets conditions: above-shoulders / thick / blunt-cut), Rule Set 3 (length matrix), Rule Set 4 (shade maps). Remaining TODOs: real shop domain, exact Gleame product names once the catalog is imported, Jenn's real 10 shades + pony shade map + fallback adjacencies. Product/variant names must match the Gleame-configured names exactly.",

  "shopDomain": "TODO-locksandmane.myshopify.com",

  "availabilityFilter": true,

  "axes": [
    {
      "key": "category",
      "label": "Shopping for",
      "source": "user_question",
      "values": [
        { "value": "extensions", "label": "Extensions" },
        { "value": "accessories", "label": "Accessories" }
      ]
    },
    {
      "key": "goal",
      "label": "Hair goal",
      "source": "user_question",
      "values": [
        { "value": "length", "label": "More Length" },
        { "value": "volume", "label": "More Volume" },
        { "value": "both", "label": "Both" }
      ]
    },
    {
      "key": "style_intent",
      "label": "The look",
      "source": "user_question",
      "$comment": "Drives accessory picks (Rule Set 1). Filler for extensions — no extension rule keys on it.",
      "values": [
        { "value": "everyday", "label": "Everyday wear" },
        { "value": "special_event", "label": "A special event" },
        { "value": "vacation", "label": "Vacation" },
        { "value": "photoshoot", "label": "Photoshoot or content" },
        { "value": "choose_for_me", "label": "Surprise Me" }
      ]
    },
    {
      "key": "current_length",
      "label": "Current hair length",
      "source": "user_question",
      "values": [
        { "value": "above_shoulders", "label": "Above my shoulders" },
        { "value": "at_shoulders", "label": "At my shoulders" },
        { "value": "past_shoulders", "label": "Past my shoulders" },
        { "value": "mid_back", "label": "Down to my mid-back" }
      ]
    },
    {
      "key": "thickness",
      "label": "Hair thickness",
      "source": "user_question",
      "values": [
        { "value": "thin", "label": "On the thinner side" },
        { "value": "medium", "label": "Medium" },
        { "value": "thick", "label": "On the thicker side" }
      ]
    },
    {
      "key": "blunt_cut",
      "label": "Blunt cut",
      "source": "user_question",
      "values": [
        { "value": "yes", "label": "Yes" },
        { "value": "no", "label": "No" }
      ]
    },
    {
      "key": "hair_shade",
      "label": "Natural hair shade",
      "source": "photo",
      "$comment": "L&M's real 10-shade range, lightest to darkest. TODO Jenn: confirm swatch hexes.",
      "values": [
        { "value": "vanilla", "label": "Vanilla", "swatchColor": "#f3d6b7" },
        { "value": "toastedmarshmallow", "label": "Toasted Marshmallow", "swatchColor": "#e8dac6" },
        { "value": "cinnamonbun", "label": "Cinnamon Bun", "swatchColor": "#f6d9c1" },
        { "value": "butterpecan", "label": "Butter Pecan", "swatchColor": "#d3a96f" },
        { "value": "butterscotch", "label": "Butterscotch", "swatchColor": "#b98a4e" },
        { "value": "peanutbuttercup", "label": "Peanut Butter Cup", "swatchColor": "#8a5f3a" },
        { "value": "gingerbread", "label": "Gingerbread", "swatchColor": "#6f452a" },
        { "value": "milkchocolate", "label": "Milk Chocolate", "swatchColor": "#483632" },
        { "value": "darkchocolate", "label": "Dark Chocolate", "swatchColor": "#261a16" },
        { "value": "espresso", "label": "Espresso", "swatchColor": "#191816" }
      ]
    }
  ],

  "questions": [
    {
      "axisKey": "category",
      "prompt": "What are you looking for today?"
    },
    {
      "axisKey": "goal",
      "prompt": "What are you hoping to change about your hair?",
      "showIf": { "axis_key": "category", "axis_value": "extensions" }
    },
    {
      "axisKey": "style_intent",
      "prompt": "What's the look for?"
    },
    {
      "axisKey": "current_length",
      "prompt": "Where does your hair fall right now?",
      "showIf": { "axis_key": "category", "axis_value": "extensions" }
    },
    {
      "axisKey": "thickness",
      "prompt": "How thick is your hair?",
      "showIf": { "axis_key": "category", "axis_value": "extensions" }
    },
    {
      "axisKey": "blunt_cut",
      "prompt": "Do you have blunt-cut hair?",
      "showIf": { "axis_key": "category", "axis_value": "extensions" },
      "optionStyle": "boxed"
    }
  ],

  "products": {
    "$comment": "Gleame product names (must match products.product_name exactly). TODO: confirm once the L&M catalog is configured. pony_14 kept because Example Response 2 references a 14″ ponytail even though the matrix only uses 18″.",
    "clip_12": "12\" Clip-In",
    "clip_16": "16\" Clip-In",
    "clip_18": "18\" Clip-In",
    "clip_20": "20\" Clip-In",
    "pony_14": "14\" Ponytail",
    "pony_18": "18\" Ponytail"
  },

  "shadeVariantMap": {
    "$comment": "hair_shade axis value → variant_title per product family (Rule Set 4). clip_in is identity (clip-ins use the AI shade directly); ponytail is Jenn's lookup map — TODO Jenn: real mapping, placeholders are identity for now.",
    "clip_in": {
      "vanilla": "Vanilla", "toastedmarshmallow": "Toasted Marshmallow", "cinnamonbun": "Cinnamon Bun",
      "butterpecan": "Butter Pecan", "butterscotch": "Butterscotch", "peanutbuttercup": "Peanut Butter Cup",
      "gingerbread": "Gingerbread", "milkchocolate": "Milk Chocolate", "darkchocolate": "Dark Chocolate",
      "espresso": "Espresso"
    },
    "ponytail": {
      "vanilla": "Vanilla", "toastedmarshmallow": "Toasted Marshmallow", "cinnamonbun": "Cinnamon Bun",
      "butterpecan": "Butter Pecan", "butterscotch": "Butterscotch", "peanutbuttercup": "Peanut Butter Cup",
      "gingerbread": "Gingerbread", "milkchocolate": "Milk Chocolate", "darkchocolate": "Dark Chocolate",
      "espresso": "Espresso"
    }
  },

  "shadeFallbacks": {
    "$comment": "TODO Jenn: nearest-shade adjacencies (used only when the availability filter finds a shade fully out of stock). Written to chat_assistant_config.quiz_shade_fallbacks. Placeholder = simple neighbors in the depth scale above.",
    "hair_shade": {
      "vanilla": ["toastedmarshmallow", "cinnamonbun"],
      "toastedmarshmallow": ["vanilla", "cinnamonbun"],
      "cinnamonbun": ["toastedmarshmallow", "butterpecan"],
      "butterpecan": ["cinnamonbun", "butterscotch"],
      "butterscotch": ["butterpecan", "peanutbuttercup"],
      "peanutbuttercup": ["butterscotch", "gingerbread"],
      "gingerbread": ["peanutbuttercup", "milkchocolate"],
      "milkchocolate": ["gingerbread", "darkchocolate"],
      "darkchocolate": ["milkchocolate", "espresso"],
      "espresso": ["darkchocolate", "milkchocolate"]
    }
  },

  "setsTable": {
    "$comment": "Rule Set 2 — 2026-07-31 spec: recommend TWO sets only when the shopper has short hair (above shoulders), super thick hair, or blunt-cut hair; everyone else gets 1. Rows are effectively OR'd (first match wins, every row yields 2, default 1). Replaces the old layers/thickness table and RESOLVES the 07-16 open question: goal=both no longer forces 2 sets — quantity comes solely from these three conditions.",
    "rows": [
      { "lengths": ["above_shoulders"], "sets": 2 },
      { "thickness": "thick", "sets": 2 },
      { "blunt_cut": "yes", "sets": 2 }
    ]
  },

  "matrix": {
    "$comment": "Rule Set 3 — 2026-07-31 lengths table: current_length × goal → hero clip-in and optional complementary ponytail. Set counts are NOT encoded per cell anymore; quantity comes entirely from setsTable. 'pony' omitted = single-recommendation cell (the whole above-shoulders row and at-shoulders+volume have no ponytail in the table).",
    "cells": [
      { "current_length": "above_shoulders", "goal": "length", "clipIn": "clip_16" },
      { "current_length": "above_shoulders", "goal": "volume", "clipIn": "clip_12" },
      { "current_length": "above_shoulders", "goal": "both",   "clipIn": "clip_16" },
      { "current_length": "at_shoulders",    "goal": "length", "clipIn": "clip_16", "pony": "pony_18" },
      { "current_length": "at_shoulders",    "goal": "volume", "clipIn": "clip_12" },
      { "current_length": "at_shoulders",    "goal": "both",   "clipIn": "clip_16", "pony": "pony_18" },
      { "current_length": "past_shoulders",  "goal": "length", "clipIn": "clip_18", "pony": "pony_18" },
      { "current_length": "past_shoulders",  "goal": "volume", "clipIn": "clip_16", "pony": "pony_18" },
      { "current_length": "past_shoulders",  "goal": "both",   "clipIn": "clip_18", "pony": "pony_18" },
      { "current_length": "mid_back",        "goal": "length", "clipIn": "clip_20", "pony": "pony_18" },
      { "current_length": "mid_back",        "goal": "volume", "clipIn": "clip_18", "pony": "pony_18" },
      { "current_length": "mid_back",        "goal": "both",   "clipIn": "clip_20", "pony": "pony_18" }
    ]
  },

  "accessories": {
    "$comment": "Rule Set 1 — top 3 accessories per style intent; category=accessories exits here (extension questions are showIf-hidden). Names derived from the locksandmane.com handles provided 2026-07-15, ASSUMING the 15-URL list reads column-by-column (3 per intent) — confirm with Jenn. 'handle' is reference only; the compiler resolves by name.",
    "byStyleIntent": {
      "everyday": [
        { "name": "Denim Headband", "handle": "denim-headband" },
        { "name": "Flourette Gem Stone Headband", "handle": "flourette-gem-stone-headband" },
        { "name": "Embroidered Floral Headband", "handle": "embroidered-floral-headband" }
      ],
      "special_event": [
        { "name": "Lavish Gemstone Headband", "handle": "lavish-gemstone-headband" },
        { "name": "3 Hearts Barrette Set", "handle": "3-hearts-barrette-set" },
        { "name": "Mini Gem Skinny Headband Gold", "handle": "mini-gem-skinny-headband-gold" }
      ],
      "vacation": [
        { "name": "Diamond Veil Headband", "handle": "diamond-veil-headband" },
        { "name": "Cozumel Headband", "handle": "cozumel-headband" },
        { "name": "Midsummer Nights Dream Headband", "handle": "midsummer-nights-dream-headband" }
      ],
      "photoshoot": [
        { "name": "Vintage Gem Headband Mint Green", "handle": "vintage-gem-headband-mint-green" },
        { "name": "So 90s Barrette Set", "handle": "so-90s-barrette-set" },
        { "name": "Pearl Laurel Headband", "handle": "pearl-laurel-headband" }
      ],
      "choose_for_me": [
        { "name": "Soft Touch Braided Headband In Blue", "handle": "soft-touch-braided-headband-in-blue" },
        { "name": "Blue Gemstone Barrette Set", "handle": "blue-gemstone-barrette-set" },
        { "name": "Tawny Diamond Headband", "handle": "tawny-diamond-headband" }
      ]
    }
  }
}
