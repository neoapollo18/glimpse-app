{
  "$comment": "Locks & Mane flow adapted for the glimpsetesting.myshopify.com dev store (demo/QA). Differences from locks-and-mane.json: real testing shop domain; extensions-only (no category axis, no accessory branch — accessories per style intent are still pending from Christa, and the demoed flow starts at the goal question); product names match the catalog created by backfill-lm-testing-catalog.cjs; availabilityFilter off (dev store inventory isn't managed). Question order mirrors the demoed flow: goal, style intent, current length, thickness, blunt cut, then the quiz's built-in photo gate for shade.",

  "shopDomain": "glimpsetesting.myshopify.com",

  "availabilityFilter": false,

  "axes": [
    {
      "key": "goal",
      "label": "Hair goal",
      "source": "user_question",
      "values": [
        { "value": "length", "label": "More Length" },
        { "value": "volume", "label": "More Volume" },
        { "value": "both", "label": "Both" }
      ]
    },
    {
      "key": "style_intent",
      "label": "The look",
      "source": "user_question",
      "$comment": "Filler for extensions (no rule keys on it) — kept so the flow matches the L&M spec and future accessory rules can key on it.",
      "values": [
        { "value": "everyday", "label": "Everyday wear" },
        { "value": "special_event", "label": "A special event" },
        { "value": "vacation", "label": "Vacation" },
        { "value": "photoshoot", "label": "Photoshoot or content" },
        { "value": "choose_for_me", "label": "Surprise Me" }
      ]
    },
    {
      "key": "current_length",
      "label": "Current hair length",
      "source": "user_question",
      "values": [
        { "value": "above_shoulders", "label": "Above my shoulders" },
        { "value": "at_shoulders", "label": "At my shoulders" },
        { "value": "past_shoulders", "label": "Past my shoulders" },
        { "value": "mid_back", "label": "Down to my mid-back" }
      ]
    },
    {
      "key": "thickness",
      "label": "Hair thickness",
      "source": "user_question",
      "values": [
        { "value": "thin", "label": "On the thinner side" },
        { "value": "medium", "label": "Medium" },
        { "value": "thick", "label": "On the thicker side" }
      ]
    },
    {
      "key": "blunt_cut",
      "label": "Blunt cut",
      "source": "user_question",
      "values": [
        { "value": "yes", "label": "Yes" },
        { "value": "no", "label": "No" }
      ]
    },
    {
      "key": "hair_shade",
      "label": "Natural hair shade",
      "source": "photo",
      "values": [
        { "value": "vanilla", "label": "Vanilla", "swatchColor": "#f3d6b7" },
        { "value": "toastedmarshmallow", "label": "Toasted Marshmallow", "swatchColor": "#e8dac6" },
        { "value": "cinnamonbun", "label": "Cinnamon Bun", "swatchColor": "#f6d9c1" },
        { "value": "butterpecan", "label": "Butter Pecan", "swatchColor": "#d3a96f" },
        { "value": "butterscotch", "label": "Butterscotch", "swatchColor": "#b98a4e" },
        { "value": "peanutbuttercup", "label": "Peanut Butter Cup", "swatchColor": "#8a5f3a" },
        { "value": "gingerbread", "label": "Gingerbread", "swatchColor": "#6f452a" },
        { "value": "milkchocolate", "label": "Milk Chocolate", "swatchColor": "#483632" },
        { "value": "darkchocolate", "label": "Dark Chocolate", "swatchColor": "#261a16" },
        { "value": "espresso", "label": "Espresso", "swatchColor": "#191816" }
      ]
    }
  ],

  "questions": [
    {
      "$comment": "helperText / option labels / sublabels / imageUrls below were merged from the live admin-styled flow on 2026-07-31 so a recompile reproduces them (the destructive-save guard checks this). 'Thick' sublabel was a live typo ('thinner') — fixed to 'thicker' here.",
      "axisKey": "goal",
      "prompt": "What are you hoping to change about your hair?",
      "helperText": "We'll tailor your match to the look you want"
    },
    {
      "axisKey": "style_intent",
      "prompt": "What's the look for?",
      "helperText": "Let's nail the style for your occasion",
      "options": [
        { "label": "Everyday Wear", "value": "everyday", "displayMeta": { "sublabel": "🙌" } },
        { "label": "A Special Event", "value": "special_event", "displayMeta": { "sublabel": "💃" } },
        { "label": "Vacation", "value": "vacation", "displayMeta": { "sublabel": "🏝️" } },
        { "label": "Photoshoot / Content", "value": "photoshoot", "displayMeta": { "sublabel": "📸" } },
        { "label": "Surprise Me", "value": "choose_for_me", "displayMeta": { "sublabel": "🤔" } }
      ]
    },
    {
      "axisKey": "current_length",
      "prompt": "Where does your hair fall right now?",
      "helperText": "Go by where your ends land - your starting length tells us which lengths will blend seamlessly",
      "options": [
        { "label": "Above my shoulders", "value": "above_shoulders", "imageUrl": "https://cdn.shopify.com/s/files/1/0693/4219/9959/files/Above_Shoulders.png?v=1785166768" },
        { "label": "At my shoulders", "value": "at_shoulders", "imageUrl": "https://cdn.shopify.com/s/files/1/0693/4219/9959/files/At_Shoulders.png?v=1785166816" },
        { "label": "Past my shoulders", "value": "past_shoulders", "imageUrl": "https://cdn.shopify.com/s/files/1/0693/4219/9959/files/Past_Shoulders.png?v=1785166737" },
        { "label": "Down to my mid-back", "value": "mid_back", "imageUrl": "https://cdn.shopify.com/s/files/1/0693/4219/9959/files/Mid_Back.png?v=1785166847" }
      ]
    },
    {
      "axisKey": "thickness",
      "prompt": "How thick is your hair?",
      "helperText": "Finer and thicker hair carry extensions differently - this helps us decide how many sets you need.",
      "options": [
        { "label": "Thin", "value": "thin", "displayMeta": { "sublabel": "On the thinner side" } },
        { "label": "Medium", "value": "medium" },
        { "label": "Thick", "value": "thick", "displayMeta": { "sublabel": "On the thicker side" } }
      ]
    },
    {
      "axisKey": "blunt_cut",
      "prompt": "Do you have blunt-cut hair?",
      "optionStyle": "boxed"
    }
  ],

  "products": {
    "$comment": "Names match products created by backfill-lm-testing-catalog.cjs (and Gleame's products.product_name) exactly.",
    "clip_12": "12\" Clip-In Extensions",
    "clip_16": "16\" Clip-In Extensions",
    "clip_18": "18\" Clip-In Extensions",
    "clip_20": "20\" Clip-In Extensions",
    "pony_18": "18\" Clip-In Ponytail"
  },

  "variantFallbackProducts": {
    "$comment": "Mirrors locks-and-mane.json (2026-08-10): a shade the 12\" clip-in doesn't stock compiles to the 16\" clip-in's variant. Inert if the testing catalog stocks all shades on the 12\", but keeps the write path exercised.",
    "clip_12": "clip_16"
  },

  "shadeVariantMap": {
    "$comment": "clip_in is identity (AI shade used directly). ponytail is identity until Jenn's real lookup map lands.",
    "clip_in": {
      "vanilla": "Vanilla", "toastedmarshmallow": "Toasted Marshmallow", "cinnamonbun": "Cinnamon Bun",
      "butterpecan": "Butter Pecan", "butterscotch": "Butterscotch", "peanutbuttercup": "Peanut Butter Cup",
      "gingerbread": "Gingerbread", "milkchocolate": "Milk Chocolate", "darkchocolate": "Dark Chocolate",
      "espresso": "Espresso"
    },
    "ponytail": {
      "vanilla": "Vanilla", "toastedmarshmallow": "Toasted Marshmallow", "cinnamonbun": "Cinnamon Bun",
      "butterpecan": "Butter Pecan", "butterscotch": "Butterscotch", "peanutbuttercup": "Peanut Butter Cup",
      "gingerbread": "Gingerbread", "milkchocolate": "Milk Chocolate", "darkchocolate": "Dark Chocolate",
      "espresso": "Espresso"
    }
  },

  "shadeFallbacks": {
    "$comment": "Placeholder nearest-neighbor adjacencies until Jenn's real ones land. Only consulted when availabilityFilter is on, so inert on the dev store — kept so the testing config exercises the same write path.",
    "hair_shade": {
      "vanilla": ["toastedmarshmallow", "cinnamonbun"],
      "toastedmarshmallow": ["vanilla", "cinnamonbun"],
      "cinnamonbun": ["toastedmarshmallow", "butterpecan"],
      "butterpecan": ["cinnamonbun", "butterscotch"],
      "butterscotch": ["butterpecan", "peanutbuttercup"],
      "peanutbuttercup": ["butterscotch", "gingerbread"],
      "gingerbread": ["peanutbuttercup", "milkchocolate"],
      "milkchocolate": ["gingerbread", "darkchocolate"],
      "darkchocolate": ["milkchocolate", "espresso"],
      "espresso": ["darkchocolate", "milkchocolate"]
    }
  },

  "setsTable": {
    "$comment": "Rule Set 2 — 2026-07-31 spec: TWO sets only for above-shoulders, thick, or blunt-cut hair (rows OR'd, default 1). Mirrors locks-and-mane.json.",
    "rows": [
      { "lengths": ["above_shoulders"], "sets": 2 },
      { "thickness": "thick", "sets": 2 },
      { "blunt_cut": "yes", "sets": 2 }
    ]
  },

  "matrix": {
    "$comment": "Rule Set 3 — same 12 cells as the production config (2026-07-31 lengths table); set counts live in setsTable only.",
    "cells": [
      { "current_length": "above_shoulders", "goal": "length", "clipIn": "clip_16" },
      { "current_length": "above_shoulders", "goal": "volume", "clipIn": "clip_12" },
      { "current_length": "above_shoulders", "goal": "both",   "clipIn": "clip_16" },
      { "current_length": "at_shoulders",    "goal": "length", "clipIn": "clip_16", "pony": "pony_18" },
      { "current_length": "at_shoulders",    "goal": "volume", "clipIn": "clip_12" },
      { "current_length": "at_shoulders",    "goal": "both",   "clipIn": "clip_16", "pony": "pony_18" },
      { "current_length": "past_shoulders",  "goal": "length", "clipIn": "clip_18", "pony": "pony_18" },
      { "current_length": "past_shoulders",  "goal": "volume", "clipIn": "clip_16", "pony": "pony_18" },
      { "current_length": "past_shoulders",  "goal": "both",   "clipIn": "clip_18", "pony": "pony_18" },
      { "current_length": "mid_back",        "goal": "length", "clipIn": "clip_20", "pony": "pony_18" },
      { "current_length": "mid_back",        "goal": "volume", "clipIn": "clip_18", "pony": "pony_18" },
      { "current_length": "mid_back",        "goal": "both",   "clipIn": "clip_20", "pony": "pony_18" }
    ]
  }
}
