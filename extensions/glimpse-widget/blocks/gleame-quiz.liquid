<!-- Gleame Quiz — "Find My Fit" full-page section block -->
{%- assign gq_domain = block.settings.manual_shop_domain | default: shop.permanent_domain -%}
{%- comment -%}
  Latency (2026-10-16): open the connections the quiz needs while the page
  is still parsing (config API, answer images), and reserve one viewport of
  height so the footer doesn't jump when the quiz renders. gleame-quiz.js
  releases the reserve after its first paint.
{%- endcomment -%}
<link rel="preconnect" href="https://glimpse-app-charles.onrender.com" crossorigin>
<link rel="preconnect" href="https://glglqybgabptczqskbcj.supabase.co">
<div id="gleame-quiz-root"
     data-shop-domain="{{ gq_domain | escape }}"
     data-cart-token="{{ cart.token }}"
     data-customer-first-name="{{ customer.first_name | escape }}"
     style="--gq-max-width: {{ block.settings.content_max_width | default: 1080 }}px;
            --gq-pad-top: {{ block.settings.section_padding_top | default: 24 }}px;
            --gq-pad-bottom: {{ block.settings.section_padding_bottom | default: 64 }}px;
            {%- unless request.design_mode %} min-height: 100vh;{% endunless %}
            {%- if block.settings.background_color != blank %} --gq-bg: {{ block.settings.background_color }};{% endif %}">
  {%- if request.design_mode -%}
    <div class="gq-editor-hint">
      <strong>Gleame Quiz</strong>
      <span>This section renders the Find My Fit quiz. If nothing appears on the live page, publish your quiz from the Gleame Quiz Studio and flip the &ldquo;Make it live&rdquo; toggle on the Gleame dashboard.</span>
    </div>
  {%- endif -%}
</div>

<script>
  // Start the quiz's two config requests now instead of after
  // gleame-quiz.js downloads and runs. The urls must match the ones
  // gleame-quiz.js builds (bootFetch reuses a promise only on an exact
  // match, so a mismatch just costs the head start). tpl mirrors
  // TEMPLATE_PROTOCOL there: bump both together.
  (function () {
    try {
      var api = 'https://glimpse-app-charles.onrender.com/api/storefront/';
      var shop = encodeURIComponent({{ gq_domain | json }});
      var configUrl = api + 'quiz-config?shopDomain=' + shop + '&tpl=3';
      var flowUrl = api + 'recommendation-config?shopDomain=' + shop;
      window.GLEAME_QUIZ_BOOT = {
        configUrl: configUrl,
        flowUrl: flowUrl,
        config: fetch(configUrl).then(function (r) { return r.json(); }).catch(function () { return null; }),
        flow: fetch(flowUrl).then(function (r) { return r.ok ? r.json() : null; }).catch(function () { return null; })
      };
    } catch (e) {}
    // Safety net: never leave an empty reserved viewport if the quiz bundle
    // fails to load at all.
    setTimeout(function () {
      var root = document.getElementById('gleame-quiz-root');
      if (root && !root.classList.contains('gq-active')) root.style.minHeight = '';
    }, 15000);
  })();
</script>
{{ 'gleame-quiz.css' | asset_url | stylesheet_tag }}
{{ 'gleame-camera.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gleame-camera.js' | asset_url }}" defer></script>
<script src="{{ 'gleame-quiz.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Gleame Quiz",
  "target": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "All quiz copy, questions, and colors are managed in the Gleame app (Dashboard → Open Studio). These settings only control how the section sits on this page."
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width",
      "min": 720,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 1080
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "text",
      "id": "manual_shop_domain",
      "label": "Shop Domain (Optional)",
      "info": "Only needed if your storefront uses a custom domain that differs from your .myshopify.com domain."
    }
  ]
}
{% endschema %}
